{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-pro",
  "permission": {
    "edit": "allow",
    "webfetch": "deny",
    "bash": {
      "*": "ask",
      ".fvm/flutter_sdk/bin/flutter *": "allow",
      ".fvm/flutter_sdk/bin/dart *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "grep *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "git push*": "deny",
      "git reset*": "deny",
      "git checkout*": "deny",
      "git rebase*": "deny",
      "git branch -D*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny",
      "curl *": "deny",
      "wget *": "deny"
    }
  }
}
